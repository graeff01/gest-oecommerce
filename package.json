    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.5.0",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.0.4",
    "framer-motion": "^11.18.2",
    "jose": "^5.9.6",
    "lucide-react": "^0.468.0",
    "next": "^15.0.4",
    "pg": "^8.20.0",
    "postcss": "^8.4.49",
    "prisma": "^6.19.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^2.13.3",
    "tailwind-merge": "^2.5.5",
