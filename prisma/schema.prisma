generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  FINANCE
  STOCK
  SALES
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  SOLD_OUT
}

enum OrderStatus {
  NEW
  PAID
  PICKING
  SHIPPED
  DELIVERED
  CANCELED
}

enum PaymentMethod {
  PIX
  CREDIT_CARD
  DEBIT_CARD
  CASH
  BANK_SLIP
  MARKETPLACE
  CREDIARIO
}

enum TransactionType {
  REVENUE
  EXPENSE
}

enum StockMovementType {
  IN
  OUT
  ADJUSTMENT
  SALE
  RETURN
}

enum AdminClientStatus {
  SETUP
  TRIAL
  ACTIVE
  SUSPENDED
  CANCELED
}

enum AdminClientPlan {
  STARTER
  PRO
  BUSINESS
  ENTERPRISE
}

model User {
  id              String      @id @default(cuid())
  name            String
  email           String      @unique
  passwordHash    String
  role            UserRole    @default(ADMIN)
  active          Boolean     @default(true)
  dashboardLayout Json?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  auditLogs       AuditLog[]
  movements       StockMovement[]
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  email     String?
  phone     String?
  document  String?
  address   String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders    Order[]

  @@index([name])
  @@index([createdAt])
}

model Supplier {
  id        String   @id @default(cuid())
  name      String
  document  String?
  contact   String?
  phone     String?
  email     String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  purchases Purchase[]
}

model Product {
  id          String        @id @default(cuid())
  name        String
  category    String
  brand       String?
  gender      String?
  description String?
  imageUrl    String?
  tags        String[]      @default([])
  status      ProductStatus @default(ACTIVE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  variants    ProductVariant[]
}

model ProductVariant {
  id            String   @id @default(cuid())
  productId     String
  sku           String   @unique
  color         String
  size          String
  barcode       String?
  costPrice     Decimal  @db.Decimal(12, 2)
  salePrice     Decimal  @db.Decimal(12, 2)
  stockQuantity Int      @default(0)
  minStock      Int      @default(2)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems    OrderItem[]
  movements     StockMovement[]
  purchaseItems PurchaseItem[]

  @@index([productId])
  @@index([stockQuantity])
}

model StockMovement {
  id          String            @id @default(cuid())
  variantId   String
  userId      String?
  type        StockMovementType
  quantity    Int
  reason      String
  createdAt   DateTime          @default(now())
  variant     ProductVariant    @relation(fields: [variantId], references: [id], onDelete: Cascade)
  user        User?             @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([variantId])
  @@index([createdAt])
}

model Order {
  id            String        @id @default(cuid())
  customerId    String?
  code          String        @unique
  channel       String        @default("Loja online")
  status        OrderStatus   @default(NEW)
  paymentMethod PaymentMethod @default(PIX)
  subtotal      Decimal       @db.Decimal(12, 2)
  discount      Decimal       @default(0) @db.Decimal(12, 2)
  fee           Decimal       @default(0) @db.Decimal(12, 2)
  total         Decimal       @db.Decimal(12, 2)
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  customer      Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items         OrderItem[]
  installments  Installment[]

  @@index([customerId])
  @@index([status])
  @@index([createdAt])
  @@index([channel])
}

model Installment {
  id            String         @id @default(cuid())
  orderId       String
  sequence      Int
  totalCount    Int
  dueDate       DateTime
  amount        Decimal        @db.Decimal(12, 2)
  paidAt        DateTime?
  paymentMethod PaymentMethod?
  notes         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  order         Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, sequence])
  @@index([dueDate])
}

model OrderItem {
  id        String          @id @default(cuid())
  orderId   String
  variantId String?
  label     String?
  quantity  Int
  unitPrice Decimal         @db.Decimal(12, 2)
  costPrice Decimal         @db.Decimal(12, 2)
  order     Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Restrict)
}

model FinancialTransaction {
  id            String          @id @default(cuid())
  type          TransactionType
  title         String
  category      String
  amount        Decimal         @db.Decimal(12, 2)
  paymentMethod PaymentMethod?
  dueDate       DateTime?
  paidAt        DateTime?
  notes         String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([type])
  @@index([createdAt])
  @@index([dueDate])
}

model Purchase {
  id         String   @id @default(cuid())
  supplierId String?
  code       String   @unique
  freight    Decimal  @default(0) @db.Decimal(12, 2)
  total      Decimal  @db.Decimal(12, 2)
  receivedAt DateTime?
  createdAt  DateTime @default(now())
  supplier   Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  items      PurchaseItem[]
}

model PurchaseItem {
  id        String         @id @default(cuid())
  purchaseId String
  variantId String
  quantity  Int
  unitCost  Decimal        @db.Decimal(12, 2)
  purchase  Purchase       @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([createdAt])
  @@index([entity, entityId])
}

model StoreSettings {
  id                 Int      @id @default(1)
  storeName          String   @default("LA WEAR")
  storeTagline       String?
  loginImageUrl      String?
  primaryColor       String?
  cashBalance        Decimal  @default(0) @db.Decimal(12, 2)
  financeCategories  String[] @default([])
  updatedAt          DateTime @updatedAt
}

model AdminClient {
  id            String                @id @default(cuid())
  key           String                @unique
  name          String
  storeName     String?
  appUrl        String?
  databaseUrl   String
  status        AdminClientStatus     @default(TRIAL)
  plan          AdminClientPlan       @default(STARTER)
  monthlyFee    Decimal?              @db.Decimal(12, 2)
  renewalDay    Int?
  notes         String?
  tags          String[]              @default([])
  contactName   String?
  contactPhone  String?
  contactEmail  String?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  tasks         AdminTask[]
  snapshots     AdminClientSnapshot[]

  @@index([status])
  @@index([plan])
  @@index([createdAt])
}

model AdminTask {
  id         String      @id @default(cuid())
  clientId   String
  title      String
  done       Boolean     @default(false)
  dueDate    DateTime?
  priority   Int         @default(0)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  client     AdminClient @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([done])
  @@index([dueDate])
}

model AdminClientSnapshot {
  id              String      @id @default(cuid())
  clientId        String
  capturedAt      DateTime    @default(now())
  online          Boolean
  salesLast7      Int         @default(0)
  salesLast30     Int         @default(0)
  totalCustomers  Int         @default(0)
  newCustomers30  Int         @default(0)
  totalProducts   Int         @default(0)
  activeUsers     Int         @default(0)
  totalUsers      Int         @default(0)
  alertCount      Int         @default(0)
  criticalCount   Int         @default(0)
  healthScore     Int         @default(0)
  client          AdminClient @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, capturedAt])
  @@index([capturedAt])
}
