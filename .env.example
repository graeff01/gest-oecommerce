# Conexão Postgres (Railway gera automaticamente em Variables -> Reference -> Postgres.DATABASE_URL)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"

# Segredo do JWT da sessão. Em produção precisa ter 32+ caracteres.
# Gere com: openssl rand -base64 48   (ou qualquer gerador de senha forte)
AUTH_SECRET="troque-por-um-segredo-longo-com-pelo-menos-32-caracteres"

# URL pública da aplicação (Railway define como https://<seu-projeto>.up.railway.app)
APP_URL="http://localhost:3000"

# Railway define automaticamente em produção
# NODE_ENV=production
