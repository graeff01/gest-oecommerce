# Conexão Postgres (Railway gera automaticamente em Variables -> Reference -> Postgres.DATABASE_URL)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"

# Segredo do JWT da sessão. Em produção precisa ter 32+ caracteres.
# Gere com: openssl rand -base64 48   (ou qualquer gerador de senha forte)
AUTH_SECRET="troque-por-um-segredo-longo-com-pelo-menos-32-caracteres"

# URL pública da aplicação (Railway define como https://<seu-projeto>.up.railway.app)
APP_URL="http://localhost:3000"

# Railway define automaticamente em produção
# NODE_ENV=production

# --- Painel Admin Master (opcional) ---
# Senha para acessar o painel em /admin
ADMIN_SECRET="troque-por-uma-senha-forte-para-o-painel-master"

# Lista de clientes para monitorar no painel master.
# Cada entrada é um deploy separado. Copie a DATABASE_URL de cada cliente.
# Formato JSON (em uma única linha):
# ADMIN_CLIENTS=[{"key":"la-wear","name":"LA WEAR","url":"postgresql://..."},{"key":"sonho","name":"Sonho de Algodão","url":"postgresql://..."}]
ADMIN_CLIENTS=[]
